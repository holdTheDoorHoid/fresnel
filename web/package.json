{
  "name": "fresnel-web",
  "private": true,
  "version": "0.1.0",
  "description": "Fresnel website: map of the lighthouses, lightships and life-saving stations of the US and Canada, prerendered station pages",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data:fixtures": "python3 ../pipeline/build_site_data.py --stations fixtures/stations --stories fixtures/stories --research fixtures/research",
    "data": "cd .. && python3 pipeline/build_site_data.py",
    "dev": "vite",
    "build": "vite build && node scripts/prerender.ts",
    "prerender": "node scripts/prerender.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "maplibre-gl": "^6.12.0"
  }
}
