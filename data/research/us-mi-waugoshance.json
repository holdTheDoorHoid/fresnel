 "evidence": [
  {
   "cite": 1,
   "supports": "nearly seven miles reach into lake; hazard",
   "quote": "extend seven miles out into Lake Michigan from the northwest corner of Michigan"
  },
  {
   "cite": 1,
   "supports": "Congress $5,000 March 1837; Pendergrast sent",
   "quote": "Congress appropriated $5,000 in March 1837 for a lighthouse at Waugoshance"
  },
  {
   "cite": 1,
   "supports": "Pendergrast on the point and reef",
   "quote": "a dangerous reef projecting out from the point to the distance of nearly half a mile"
  },
  {
   "cite": 1,
   "supports": "detached reef dimensions and depth",
   "quote": "This reef is only about fifty yards wide and two hundred long"
  },
  {
   "cite": 1,
   "supports": "depth over reef",
   "quote": "having from five to seven feet water upon it"
  },
  {
   "cite": 1,
   "supports": "lightship role/use",
   "quote": "the lightboat can be very usefully employed in the Maumee bay"
  },
  {
   "cite": 1,
   "supports": "lightship 1832",
   "quote": "The Mackinaw Straits Lightship mentioned by Pendergrast had been established in 1832 and was the first and only lightship on the Great Lakes at that time"
  },
  {
   "cite": 1,
   "supports": "1838 $25,000; nothing until 1847",
   "quote": "Congress provided $25,000 in 1838 for building a lighthouse"
  },
  {
   "cite": 1,
   "supports": "transfer 1847",
   "quote": "Nothing, however, was done on the project until 1847, when the work was transferred to the Bureau of Topographical Engineers"
  },
  {
   "cite": 1,
   "supports": "total cost",
   "quote": "bringing the total cost of the lighthouse to $83,945"
  },
  {
   "cite": 1,
   "supports": "Canfield in charge",
   "quote": "Captain Augustus Canfield of the Corps of Engineers was placed in charge of constructing Waugoshance Lighthouse"
  },
  {
   "cite": 1,
   "supports": "cribs from St Helena",
   "quote": "fifty-foot-square wooden piers were constructed on St. Helena Island out of white and yellow pine, and then towed fourteen miles to the shoal and filled with stone"
  },
  {
   "cite": 1,
   "supports": "brick tower and dwelling",
   "quote": "yellow Milwaukee brick was used to build a circular tower with a diameter of twenty feet at its base and fourteen feet at its top"
  },
  {
   "cite": 1,
   "supports": "dwelling",
   "quote": "A one-and-a-half-story, brick keeper"
  },
